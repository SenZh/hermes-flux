# Hermes Flux 环境变量样例
#
# 用法：复制为 .env（已在 .gitignore 中忽略），或用系统环境变量注入。
# 铁律：本仓库任何文件都不得写入真实网关地址、账号或密码。

# ── 网关契约同步（离线，读本地网关仓库） ──────────────────────────────
# 指向 hermes-agent 仓库根目录，用于生成 packages/core/src/rpc/contracts/*
HERMES_GATEWAY_REPO=

# ── 真实网关探针（在线，录 fixture 用） ────────────────────────────────
# 仅在你需要重新录制真实响应时填写；CI 不依赖这些变量。
HERMES_GATEWAY_URL=
HERMES_GATEWAY_USER=
HERMES_GATEWAY_PASSWORD=
# 可选：指定探测用的 profile，缺省取网关的 default
HERMES_GATEWAY_PROFILE=

# ── 本地 Python 网关联调（test:live-gateway） ──────────────────────────
# 两个都配置且路径存在时才会执行，否则整组 skip。
HERMES_GATEWAY_PYTHON=
# 与上面的 HERMES_GATEWAY_REPO 相同，可复用

# ── 运行期开关 ────────────────────────────────────────────────────────
# 关闭 RPC 契约守卫（仅限排障，禁止长期关闭）
FLUX_CONTRACT_GUARD=1
# 日志级别：文件默认 debug，控制台默认 info
FUS_LOG_LEVEL=
