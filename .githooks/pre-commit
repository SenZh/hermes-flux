#!/bin/sh
# Hermes Flux pre-commit 钩子入口（跨平台 shim）
#
# 防范的历史坑：
#   Windows 下部分 GUI Git 工具（SourceTree、TortoiseGit、VS Code Git 扩展）
#   在启动进程时环境变量中可能缺失用户自定义的 PATH，导致找不到 `node` 报 command not found。
#   因此优先探测 PATH 中的 node，其次探测 Windows 标准安装路径兜底。

NODE_BIN="node"
if ! command -v node >/dev/null 2>&1; then
  if [ -x "/c/Program Files/nodejs/node.exe" ]; then
    NODE_BIN="/c/Program Files/nodejs/node.exe"
  elif [ -x "C:\\Program Files\\nodejs\\node.exe" ]; then
    NODE_BIN="C:\\Program Files\\nodejs\\node.exe"
  fi
fi

exec "$NODE_BIN" "$(dirname "$0")/pre-commit.mjs"
