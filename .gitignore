# Dependencies
node_modules/
.pnpm-store/

# Builds & Binaries
dist/
release/
build/
# electron-builder build resources (brand icons) are source assets, not build output
!packages/desktop/build/
!packages/desktop/build/**
*.exe
*.zip
*.dmg
*.AppImage

# Environment & Credentials (STRICT)
.env
.env.*
# 样例文件只含变量名，不含任何真实值，必须能入库
!.env.example
*.local
credentials.json
*.key
*.pem

# Test & Logs
coverage/
artifacts/
.agents/
*.log
npm-debug.log*
.tsbuildinfo

# Design source files (large binaries stay local)
*.psd
ui/aill.jpg
ui/icon1.jpg

tmp-*.mjs
*.log
.playwright-mcp/

# 统一用 npm + package-lock.json 作为唯一权威锁。
# bun.lock 只是本地 bun 开发时的副产物，双锁并存必然漂移
# （实测曾出现 package.json 要 electron 34.2.0 而 lock 记 ^45.1.0），
# 故保持忽略，不入库。
bun.lock

# 变异测试（Stryker）运行残留：沙箱目录与 tap-runner 的覆盖率直写文件。
# 它们既不进版本库，也不该出现在 git status 里干扰改动集判定。
.stryker-tmp/
reports/
stryker-output-*.json


# CDP 测试现场打包产物（每次运行重建）
packages/desktop/__tests__/cdp/.tmp/

# OpenChamber 浏览器面板的截图与本地会话产物
.openchamber/
