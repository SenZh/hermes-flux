*.psd
ui/aill.jpg
ui/icon1.jpg

tmp-*.mjs
*.log
.playwright-mcp/
bun.lock


# CDP 测试现场打包产物（每次运行重建）
packages/desktop/__tests__/cdp/.tmp/
