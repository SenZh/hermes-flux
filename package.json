{
  "name": "hermes-flux-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes Flux: The Elegant Universal Workspace for Hermes Agent (Desktop, Web, iOS, Android)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:core": "tsc --build packages/core/tsconfig.json",
    "build:ui": "tsc --build packages/ui/tsconfig.json",
    "build:desktop": "node packages/desktop/scripts/build.mjs",
    "build": "npm run build:core && npm run build:ui && npm run build:desktop",
    "build:mobile:assets": "node packages/mobile/scripts/prepare-assets.mjs",
    "start:browser": "npm run build && node scripts/start-browser-live.mjs",
    "package:desktop:win": "npm --workspace=@hermes-flux/desktop run package:win",
    "package:desktop:win:dir": "npm --workspace=@hermes-flux/desktop run package:win:dir",
    "package:mobile:android": "npm --workspace=@hermes-flux/mobile run build:android",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 packages/core/__tests__/**/*.test.mjs packages/ui/__tests__/**/*.test.mjs packages/desktop/__tests__/unit/**/*.test.mjs scripts/__tests__/**/*.test.mjs",
    "verify:formal": "node --test packages/core/__tests__/formal/**/*.test.mjs",
    "test:mobile:cdp": "node packages/mobile/scripts/prepare-assets.mjs && node --test packages/mobile/__tests__/cdp-mobile-bridge.test.mjs",
    "test:mobile:emulator": "node packages/mobile/__tests__/adb-mobile-runner.mjs",
    "test:isolated": "node scripts/gates/run-isolated-tests.mjs",
    "verify:gallery": "node scripts/verify/gallery.mjs",
    "verify:presence": "electron scripts/verify/agent-presence-css-probe.cjs",
    "test:gateway": "node --test packages/core/__tests__/rpc/gateway-e2e.test.mjs",
    "test:live-gateway": "node --test packages/core/__tests__/rpc/live-gateway-real.test.mjs",
    "test:cdp": "node --test --test-concurrency=1 packages/desktop/__tests__/cdp/advanced-systems-cdp.test.mjs packages/desktop/__tests__/cdp/e2e-acceptance-cdp.test.mjs packages/desktop/__tests__/cdp/interactive-stage-cdp.test.mjs packages/desktop/__tests__/cdp/conversation-perf-cdp.test.mjs packages/desktop/__tests__/cdp/rail-handle-symmetry-cdp.test.mjs packages/desktop/__tests__/cdp/rail-cockpit-form-cdp.test.mjs packages/desktop/__tests__/cdp/settings-center-cdp.test.mjs packages/desktop/__tests__/cdp/older-pagination-cdp.test.mjs",
    "test:perf:cdp": "node --test packages/desktop/__tests__/cdp/conversation-perf-cdp.test.mjs",
    "test:e2e:left-rail": "node --test packages/desktop/__tests__/e2e/left-rail-live-cdp.test.mjs",
    "test:perf": "node scripts/gates/perf-benchmark.mjs",
    "lint": "echo 'Checking monorepo lint...'",
    "typecheck": "tsc --build packages/core/tsconfig.json packages/ui/tsconfig.json && tsc --project packages/desktop/tsconfig.json --noEmit",
    "gates": "node scripts/gates/run.mjs",
    "gates:changed": "node scripts/gates/run.mjs --changed",
    "gates:strict": "node scripts/gates/run.mjs --strict",
    "gates:json": "node scripts/gates/run.mjs --json",
    "gates:freeze": "node scripts/gates/run.mjs --update-baseline",
    "gates:mutation": "node scripts/gates/mutation-check.mjs",
    "gates:config": "node scripts/gates/verify-config.mjs",
    "contract:sync": "node scripts/contract/sync.mjs",
    "contract:verify": "node scripts/contract/verify.mjs",
    "contract:coverage": "node scripts/contract/coverage.mjs",
    "contract:doc": "node scripts/contract/doc.mjs",
    "contract:doc:check": "node scripts/contract/doc.mjs --check",
    "probe:gateway": "node scripts/contract/probe.mjs",
    "probe:drift": "node scripts/contract/probe.mjs --check",
    "verify": "npm run gates && npm run contract:verify && npm run contract:coverage && npm run contract:doc:check && npm run typecheck && npm test && npm run verify:formal",
    "verify:display-kind": "node scripts/verify/display-kind-check.mjs",
    "prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks'); } catch {}\""
  },
  "devDependencies": {
    "electron": "34.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^5.8.0"
  }
}
