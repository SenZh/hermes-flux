{
  "name": "hermes-flux-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes Flux: The Elegant Universal Workspace for Hermes Agent (Desktop, Web, iOS, Android)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "tsc --build packages/core/tsconfig.json",
    "build:ui": "tsc --build packages/ui/tsconfig.json",
    "build:desktop": "node packages/desktop/scripts/build.mjs",
    "build": "npm run build:core && npm run build:ui && npm run build:desktop",
    "package:desktop:win": "npm --workspace=@hermes-flux/desktop run package:win",
    "package:desktop:win:dir": "npm --workspace=@hermes-flux/desktop run package:win:dir",
    "test": "node --test packages/core/__tests__/**/*.test.mjs packages/ui/__tests__/**/*.test.mjs",
    "test:gateway": "node --test packages/core/__tests__/rpc/gateway-e2e.test.mjs",
    "lint": "echo 'Checking monorepo lint...'",
    "typecheck": "tsc --build packages/core/tsconfig.json packages/ui/tsconfig.json && tsc --project packages/desktop/tsconfig.json --noEmit",
    "gates": "node scripts/gates/run.mjs",
    "gates:changed": "node scripts/gates/run.mjs --changed",
    "gates:strict": "node scripts/gates/run.mjs --strict",
    "gates:json": "node scripts/gates/run.mjs --json",
    "gates:freeze": "node scripts/gates/run.mjs --update-baseline",
    "gates:mutation": "node scripts/gates/mutation-check.mjs",
    "gates:config": "node scripts/gates/verify-config.mjs",
    "verify": "npm run gates && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "electron": "34.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
